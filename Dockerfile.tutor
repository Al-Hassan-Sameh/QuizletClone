FROM node:22-alpine
ENV NODE_ENV=production TUTOR_HOST=0.0.0.0 TUTOR_PORT=8787 TUTOR_DATA_DIR=/data
WORKDIR /app
RUN mkdir -p /data && chown node:node /data
COPY --chown=node:node server/tutor.mjs ./server/tutor.mjs
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.TUTOR_PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/tutor.mjs"]
