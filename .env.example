# Copy to .env on the SERVER ONLY. Never use a VITE_ prefix for secrets.
TUTOR_API_KEY=
TUTOR_PROVIDER_URL=https://api.openai.com/v1/chat/completions
TUTOR_MODEL=gpt-4o-mini
# Map personal account names to SHA-256 hashes of separate random access tokens.
# Generate tokens and hashes as documented in docs/AI_TUTOR.md. No shared provider key in the browser.
TUTOR_USERS_JSON={}
TUTOR_ALLOWED_ORIGINS=http://localhost:5173
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8787
TUTOR_DATA_DIR=.tutor-data

# Public frontend configuration only. Never put a service-role key here.
# Leave empty for fully offline guest mode. Rebuild after changing VITE_ values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
